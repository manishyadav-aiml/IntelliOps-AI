# ============================================================
# SECRETS AND ENVIRONMENT CONFIGURATION
# ============================================================

# Ignore private environment files
**/.env
**/.env.*

# Allow safe example environment files
!**/.env.example


# ============================================================
# PYTHON
# ============================================================

__pycache__/
*.py[cod]

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

.coverage
.coverage.*
htmlcov/


# ============================================================
# DATABASES
# ============================================================

*.db
*.sqlite
*.sqlite3


# ============================================================
# NODE.JS / FRONTEND
# ============================================================

node_modules/
frontend/dist/

coverage/
playwright-report/
test-results/

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# TypeScript build cache
*.tsbuildinfo


# ============================================================
# DATA AND GENERATED FILES
# ============================================================

# Generated or private datasets
data/raw/
data/uploads/
data/processed/
data/reports/

uploads/
reports/

# IntelliOps E2E-generated data
data/e2e_models/
data/e2e_reports/
data/e2e_uploads/

# Preserve curated demonstration data
!data/sample_documents/
!data/sample_documents/**
!data/sample_logs/
!data/sample_logs/**


# ============================================================
# MACHINE LEARNING ARTEFACTS
# ============================================================

# Generated model and index binaries
*.joblib
*.pkl
*.pickle
*.faiss
*.npy

# Do not ignore application source directories named models.
# backend/app/models/ contains essential Python source code.


# ============================================================
# LOGS
# ============================================================

# Ignore generated logs globally
*.log
logs/

# Allow curated sample logs
!data/sample_logs/
!data/sample_logs/*.log


# ============================================================
# IDE AND OPERATING SYSTEM
# ============================================================

.DS_Store
Thumbs.db

.idea/
.vscode/


# ============================================================
# TEMPORARY FILES
# ============================================================

*.tmp
*.temp
*.bak
*.swp
*.swo