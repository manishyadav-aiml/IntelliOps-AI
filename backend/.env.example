# ============================================================
# IntelliOps AI — Backend Environment Configuration
# ============================================================
# Copy this file to .env and configure values for your machine.
# NEVER commit your actual .env file to GitHub.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME=IntelliOps AI
# development | testing | production
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO


# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# Generate using:
# python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=
JWT_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_ENABLED=true


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# PostgreSQL connection string.
# Replace placeholders with your local database credentials.

DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:5432/<database>


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

# Comma-separated frontend origins.

CORS_ORIGINS=http://localhost:5173


# ------------------------------------------------------------
# Log Management
# ------------------------------------------------------------

UPLOAD_DIR=data/uploads

# drain (Drain3, falls back to regex masking if not installed)
# regex
LOG_TEMPLATE_MINER=drain

LOG_MAX_LINE_LENGTH=10000
LOG_BATCH_SIZE=1000

# Optional JSON list of extra regex patterns.
# Example:
# LOG_PARSER_EXTRA_PATTERNS=["^(?P<level>[A-Z]+)\\|(?P<service>\\w+)\\|(?P<message>.*)$"]

LOG_PARSER_EXTRA_PATTERNS=


# ------------------------------------------------------------
# Generative AI — Provider Configuration
# ------------------------------------------------------------

# Keep actual API keys in backend/.env only.
# Never expose provider API keys in frontend environment variables.

GEMINI_API_KEY=
LLM_PROVIDER=gemini

GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=30


# ------------------------------------------------------------
# Embeddings and Vector Search
# ------------------------------------------------------------

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MATCHER=faiss

# Optional Redis connection.
REDIS_URL=

MAX_UPLOAD_SIZE_MB=50


# ------------------------------------------------------------
# Machine Learning and Incident Detection
# ------------------------------------------------------------

MODELS_DIR=models
INDEX_DIR=models/indexes

ANOMALY_WINDOW_SECONDS=60

# Optional override of a trained model's threshold.
# ANOMALY_THRESHOLD=

SIMILARITY_MIN_SCORE=0.3

# Use lexical hashing fallback if the embedding model
# cannot be loaded.

EMBEDDING_FALLBACK=true


# ------------------------------------------------------------
# Retrieval-Augmented Generation (RAG)
# ------------------------------------------------------------

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.15


# ------------------------------------------------------------
# Reports
# ------------------------------------------------------------

REPORTS_DIR=data/reports


# ============================================================
# END OF CONFIGURATION
# ============================================================